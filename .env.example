# .env.example
# ---- Required ----
OPENROUTER_API_KEY=

# ---- Defaults ----
DEFAULT_MODEL=openai/gpt-4o-mini
DEFAULT_PARALLEL=2

# Judge model used by category 07_Amiko_Social graders (LLM-as-judge).
# Default is Opus 4.7 for strict prose grading. Override to a cheaper model
# (e.g. anthropic/claude-haiku-4.7) for fast iteration.
JUDGE_MODEL=anthropic/claude-opus-4.7

# Override the OpenRouter base URL if you need to route via a proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Per-channel test fixtures (optional, leave blank for offline channel mocks) ----
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
